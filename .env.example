DATABASE_URL=sqlite://./data/file.db?mode=rwc&cache=shared
TEMP_PATH=/var/lib/storage/temp
CONFIG_PATH=./config
MOUNT_PATH=/Users/dqh/cloud
HTTP_PORT=8088
MAX_NUMBER_OF_SHARD=3
ALLOWED_ORIGINS=http://localhost:5173
# Keep NFS loopback unless you explicitly protect the network
NFS_BIND_ADDR=127.0.0.1:11111
# Explicit OAuth callback base; when unset the request Host header is used
PUBLIC_BASE_URL=http://127.0.0.1:8088
# Restrict native plugins by name; unset means all plugins are trusted
PLUGIN_ALLOWLIST=cloud-ui
# Optional; if unset a key file is generated at ./data/encryption.key
#DATA_ENCRYPTION_KEY=change-me
#DATA_KEY_PATH=./data/encryption.key
# Default data_root written on OAuth callback success (default: /app/share-desk)
#DEFAULT_DATA_ROOT=/app/share-desk
# Tokio worker threads; default = CPU core count (set lower on small devices)
#TOKIO_WORKER_THREADS=4
# Local block cache quota in GB and watermark warning percent (default: 20GB / 80%)
#CACHE_MAX_GB=20
#CACHE_WATERMARK_PERCENT=80

# Cloud Provider Credentials (REPLACE WITH YOUR ACTUAL VALUES)
ALI_YUN_APP_ID=your_aliyun_app_id
ALI_YUN_APP_SECRET=your_aliyun_app_secret
BAIDU_YUN_APP_ID=your_baidu_app_id
BAIDU_YUN_APP_SECRET=your_baidu_app_secret
ONE_DRIVE_APP_ID=your_onedrive_app_id
ONE_DRIVE_APP_SECRET=your_onedrive_app_secret
GOOGLE_DRIVE_APP_ID=your_googledrive_app_id
GOOGLE_DRIVE_APP_SECRET=your_googledrive_app_secret

# 上传队列重试治理 (#15)
# 连续失败达到 UPLOAD_MAX_ATTEMPTS 次后副本块进入死信状态（status=10），不再自动重试
#UPLOAD_MAX_ATTEMPTS=10
# 指数退避基数（秒）：第 n 次失败后等待 base*2^(n-1)，封顶 1 小时，含随机抖动
#UPLOAD_BACKOFF_BASE_SECONDS=60
